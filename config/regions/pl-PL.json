  "taglines": [
    "Nie każda tajemnica powinna ujrzeć światło dzienne.",
    "Jedna decyzja może zmienić wszystko.",
    "Przeszłość zawsze znajduje drogę powrotną.",
    "Niektóre historie zaczynają się od końca.",
    "Prawda ma swoją cenę.",
    "Czasami najtrudniej wrócić do domu.",
    "Kiedy znikają odpowiedzi, pozostają pytania.",
    "Ostatnia szansa na zmianę losu.",
    "Między strachem a nadzieją jest tylko jeden krok.",
    "Każda droga prowadzi do innej historii.",
    "Wystarczy jedna noc, by wszystko straciło sens.",
    "Przypadek nie istnieje."
  ],
  "reviews": [
    "Świetna gra aktorska i historia, która zostaje w pamięci.",
    "Znakomicie zbudowane napięcie, szczególnie w drugiej połowie.",
    "Nieoczywisty scenariusz i bardzo dobre zdjęcia.",
    "Film porusza ważne tematy, nie podając prostych odpowiedzi.",
    "Początek jest spokojny, ale finał wynagradza cierpliwość.",
    "Wyraziste postacie i naprawdę przekonujące dialogi.",
    "Klimatyczna muzyka świetnie współgra z obrazem.",
    "Kilka scen zapamiętam na długo.",
    "Nie wszystko działa idealnie, ale całość robi duże wrażenie.",
    "Dobrze opowiedziana historia, bez niepotrzebnych dłużyzn.",
    "Zaskakująco wzruszający film z piękną scenografią.",
    "Interesujące połączenie gatunków i świeże spojrzenie na temat.",
    "Momentami przewidywalny, lecz bardzo przyjemny w odbiorze.",
    "Dobre tempo, wiarygodne relacje i świetnie dobrana obsada.",
    "Wciągający od pierwszej do ostatniej minuty."
  ],
