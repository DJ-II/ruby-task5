<!doctype html>
<html lang="<%= regions.first.fetch(:html_lang) %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0d1119">
  <meta name="description" content="Explore a reproducible world of generative movies and cinematic previews.">
  <title><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('page_title')) %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <script defer src="/trailer.js"></script>
  <script defer src="/app.js"></script>
</head>
<body data-initial-seed="<%= initial_seed %>">
  <header class="site-header">
    <div class="container-wide header-inner header-centered">
      <a href="/" class="brand brand-centered" aria-label="MovieGenerator home" data-i18n-aria="brand_home">MovieGenerator<span class="brand-dot">.</span></a>
    </div>
  </header>

  <main class="container-wide">
    <div class="search-heading"><h1 data-i18n="search_title"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('search_title')) %></h1></div>
    <section class="filter-panel" aria-label="Generation controls" data-i18n-aria="controls_label">
      <div class="controls-grid">
        <label class="control-field control-region"><span class="field-caption" data-i18n="language_region"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('language_region')) %></span><select id="region" class="field-input region-select"><% regions.each do |region| %><option value="<%= region.fetch(:code) %>" <%= 'selected' if region.fetch(:code) == default_region %>><%= region.fetch(:label) %></option><% end %></select></label>
        <label class="control-field control-seed"><span class="field-caption" data-i18n="generation_seed"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('generation_seed')) %></span><span class="seed-holder"><input id="seed" class="field-input" type="text" inputmode="numeric" value="<%= initial_seed %>" autocomplete="off" spellcheck="false" aria-label="Generation seed"><button id="shuffle-seed" type="button" class="seed-shuffle" title="Random 64-bit seed" aria-label="Generate random seed" data-i18n-title="random_seed" data-i18n-aria="random_seed">↻</button></span></label>
        <label class="control-field"><span class="field-caption"><span data-i18n="avg_likes"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('avg_likes')) %></span> <strong id="likes-label">0.5</strong></span><div class="range-control"><input id="likes" type="range" class="form-range slider" min="0" max="10" step="0.1" value="0.5"><input id="likes-number" class="range-number" type="number" min="0" max="10" step="0.1" value="0.5" aria-label="Average likes" data-i18n-aria="average_likes"></div></label>
        <label class="control-field"><span class="field-caption"><span data-i18n="avg_reviews"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('avg_reviews')) %></span> <strong id="reviews-label">2</strong></span><div class="range-control"><input id="reviews" type="range" class="form-range slider" min="0" max="10" step="0.1" value="2"><input id="reviews-number" class="range-number" type="number" min="0" max="10" step="0.1" value="2" aria-label="Average reviews" data-i18n-aria="average_reviews"></div></label>
      </div>
      <div class="feedback is-hidden" id="feedback" role="status" aria-live="polite"></div>
      <span id="media-status" hidden></span>
    </section>

    <section class="catalog" aria-label="Movies catalog" data-i18n-aria="catalog_label">
      <div class="catalog-top">
        <h2 data-i18n="discover_movies"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('discover_movies')) %></h2>
        <div class="view-switch" role="group" aria-label="Catalog view" data-i18n-aria="view_label">
          <button type="button" id="gallery-tab" class="view-btn active" aria-pressed="true"><span class="view-icon">▦</span> <span data-i18n="gallery"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('gallery')) %></span></button>
          <button type="button" id="table-tab" class="view-btn" aria-pressed="false"><span class="view-icon">☷</span> <span data-i18n="table"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('table')) %></span></button>
        </div>
      </div>
      <div class="catalog-meta"><span id="catalog-status" data-i18n="loading_first"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('loading_first')) %></span></div>
      <div id="gallery-view" class="gallery-grid" aria-live="polite"></div>
      <div id="gallery-sentinel" class="gallery-sentinel"><span class="loader-dot"></span><span data-i18n="scroll_more"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('scroll_more')) %></span></div>
      <div id="table-view" class="table-panel" hidden><div class="table-responsive"><table class="movie-table"><thead><tr><th scope="col">#</th><th scope="col" data-i18n="movie"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('movie')) %></th><th scope="col" data-i18n="year"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('year')) %></th><th scope="col" data-i18n="genre"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('genre')) %></th><th scope="col" data-i18n="cast"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('cast')) %></th><th scope="col"></th></tr></thead><tbody id="movie-tbody"></tbody></table></div><div class="table-bottom"><div class="table-export-group"><button id="export-trailers" class="page-btn export-btn" type="button" data-i18n="export_zip">Export trailers ZIP</button><span id="export-progress" role="status" class="export-progress" aria-live="polite"></span></div><span id="page-summary">Page 1</span><nav aria-label="Table pages"><button id="prev-page" class="page-btn" type="button" data-i18n="previous"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('previous')) %></button><span id="current-page" class="page-number">1</span><button id="next-page" class="page-btn" type="button" data-i18n="next"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('next')) %></button></nav></div></div>
    </section>
  </main>

  <footer class="site-footer"><div class="container-wide footer-inner footer-minimal"><span>MovieGenerator © 2026</span><a class="pexels-link" href="https://www.pexels.com/" target="_blank" rel="noopener noreferrer" data-i18n="footage"><%= ERB::Util.html_escape(ui_translations.fetch(default_region).fetch('footage')) %></a></div></footer>

  <div id="detail-modal" class="detail-overlay" role="dialog" aria-modal="true" aria-label="Movie details" data-i18n-aria="movie_details" hidden><div class="detail-shell"><button id="close-detail" class="close-modal" type="button" aria-label="Close details" data-i18n-aria="close_details">×</button><div id="detail-content"></div></div></div>
  <script type="application/json" id="region-config"><%= JSON.generate({regions: regions, default: default_region}).gsub("<", "\\u003c") %></script>
  <script type="application/json" id="ui-translations"><%= JSON.generate(ui_translations).gsub("<", "\\u003c") %></script>
  <template id="movie-card-template"><article class="movie-card"><button class="card-poster" type="button"><div class="poster-image"></div><div class="poster-overlay"></div><span class="poster-index"></span><div class="poster-titles"><span class="poster-genre"></span><h3 class="poster-title"></h3><span class="poster-year"></span></div><span class="poster-action">▶</span></button><div class="card-description"><div><div class="card-title"></div><div class="card-subtitle"></div></div><span class="card-social"></span></div></article></template>
</body>
</html>
